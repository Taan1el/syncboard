# Copy to .env and adjust. Nothing loads this file automatically; export the
# values or run Node with --env-file, for example:
#   node --env-file=.env server/dist/server/src/index.js

# Port the HTTP and WebSocket server listens on.
PORT=4000

# SQLite file. Defaults to data/syncboard.db under the working directory.
SYNCBOARD_DB=data/syncboard.db

# Directory with the built client. Defaults to client/dist.
CLIENT_DIST=client/dist
